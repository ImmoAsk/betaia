# Configuration Widget Annonces Betaia (exemple)
# Copiez ce fichier en .env et modifiez les valeurs

# URL de l'API GraphQL betaia (REQUIS)
API_BASE_URL=

# URL de base pour les images des proprietes (REQUIS)
IMAGE_BASE_URL=

# URL du site ImmoAsk pour la redirection au clic (optionnel)
IMMOASK_URL=https://www.immoask.com

# Port du serveur proxy (optionnel, defaut: 3500)
PORT=3500

# Nombre d'annonces par defaut du widget (si data-max-ads n'est pas fourni)
WIDGET_DEFAULT_MAX_ADS=5

# ===== CTA bas de widget (placeholders) =====
# URL du bouton "Telecharger notre magazine"
WIDGET_MAGAZINE_URL=https://www.immoask.com/tg
# Nom du fichier si WIDGET_MAGAZINE_URL pointe vers un PDF
WIDGET_MAGAZINE_DOWNLOAD_NAME=magazine.pdf
# URL du bouton "Appli mobile" (page unique ou store)
WIDGET_APP_URL=https://www.immoask.com/tg
# Optionnel: liens store separes
WIDGET_APP_ANDROID_URL=https://www.immoask.com/tg
WIDGET_APP_IOS_URL=https://www.immoask.com/tg
# Libelles boutons
WIDGET_MAGAZINE_LABEL=Télécharger notre magazine
WIDGET_APP_LABEL=Notre appli mobile

# ===== Parametres marketing (UTM) =====
WIDGET_UTM_MEDIUM=widget
WIDGET_UTM_CAMPAIGN=immoask_widget

# ===== Parametres de rotation (defaults) =====
WIDGET_DEFAULT_SLIDE_INTERVAL_MS=5000

# ===== Prechauffage proxy =====
# Intervalle de rechauffe des 4 filtres principaux pour garder le cache chaud
PROXY_PREWARM_INTERVAL_MS=20000
