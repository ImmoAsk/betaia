# Configuration Widget Annonces Betaia (exemple)
# Copiez ce fichier en .env et modifiez les valeurs

# URL de l'API GraphQL betaia (REQUIS)
API_BASE_URL=

# URL de base pour les images des proprietes (REQUIS)
IMAGE_BASE_URL=

# Port du serveur proxy (optionnel, defaut: 3500)
PORT=3500

# Nombre d'annonces par defaut du widget (si data-max-ads n'est pas fourni)
WIDGET_DEFAULT_MAX_ADS=5
